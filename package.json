{
  "name": "@abraham/m.css",
  "version": "0.0.0",
  "description": "A clean, modern classless CSS framework.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist",
    "skills"
  ],
  "style": "dist/m.css",
  "exports": {
    ".": "./dist/m.css",
    "./min": "./dist/m.min.css"
  },
  "jsdelivr": "dist/m.min.css",
  "unpkg": "dist/m.min.css",
  "publishConfig": {
    "access": "public"
  },
  "browserslist": [
    "last 2 Chrome major versions",
    "last 2 Edge major versions",
    "last 2 Firefox major versions",
    "last 2 Safari major versions",
    "last 2 iOS major versions"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "start": "node scripts/dev.ts",
    "lint": "stylelint \"src/**/*.css\"",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node scripts/size.ts",
    "test": "playwright test --project=chromium --project=webkit --grep-invert \"@visual|@legacy\"",
    "test:visual": "docker run --rm --ipc=host -v \"$PWD\":/work -v /work/node_modules -w /work mcr.microsoft.com/playwright:v1.65.0-noble sh -c 'npm ci --no-audit --no-fund && npx playwright test --grep @visual \"$@\"' --",
    "test:legacy": "playwright test --project=chromium --grep @legacy",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^26.6.6",
    "browserslist": "^4.29.5",
    "lightningcss": "^1.33.0",
    "prettier": "3.9.10",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "6.0.3"
  }
}
