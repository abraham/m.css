{
  "name": "@abraham/modern.css",
  "version": "0.1.1",
  "description": "A clean, modern classless CSS framework.",
  "license": "MIT",
  "homepage": "https://modern.ink",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abraham/modern.css.git"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "style": "dist/modern.css",
  "exports": {
    ".": "./dist/modern.css",
    "./min": "./dist/modern.min.css"
  },
  "jsdelivr": "dist/modern.min.css",
  "unpkg": "dist/modern.min.css",
  "publishConfig": {
    "access": "public"
  },
  "browserslist": [
    "last 2 Chrome major versions",
    "last 2 Edge major versions",
    "last 2 Firefox major versions",
    "last 2 Safari major versions",
    "last 2 iOS major versions"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "start": "node scripts/dev.ts",
    "lint": "stylelint \"src/**/*.css\"",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node scripts/size.ts",
    "test": "playwright test --project=chromium --project=webkit --grep-invert \"@visual|@legacy\"",
    "test:visual": "scripts/test-visual.sh",
    "test:legacy": "playwright test --project=chromium --grep @legacy",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^26.6.6",
    "browserslist": "^4.29.5",
    "lightningcss": "^1.33.0",
    "prettier": "3.9.10",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "6.0.3"
  }
}
